{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "includeFiles": "server/**", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/index?route=:route*" }
  ]
}
